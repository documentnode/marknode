{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "paths": { "marknode": ["./types/marknode.d.ts"] }
  },
  "include": [
    "types/**/*.d.ts",
    "builtin/**/*.js",
    "builtin/**/*.ts",
    "examples/**/src/**/*.ts"
  ]
}
